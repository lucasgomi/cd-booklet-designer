    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@fontsource/yeseva-one": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@fontsource/zen-dots": "^5.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsbarcode": "^3.12.3",
    "qrcode-generator": "^2.0.4",
    "sortablejs": "^1.15.7"
  },
  "build": {
    "appId": "com.lucasgomi.cdbooklet",
    "productName": "CD Booklet Designer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!src/**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "cdbook",
        "name": "Proyecto de librito de CD",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CD-Booklet-Designer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CD-Booklet-Designer-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lucasgomi",
        "repo": "cd-booklet-designer"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasgomi/cd-booklet-designer.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
