{
  "name": "cd-booklet",
  "productName": "CD Booklet Designer",
  "version": "1.1.0",
  "description": "Editor de libritos para cajas de CD slim",
  "author": "lucasgomi",
  "license": "MIT",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node scripts/prepare-vendor.js",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.js",
    "dist:win": "electron-builder --win nsis portable"
  },
