    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/bowlby-one": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/climate-crisis": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/fugaz-one": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/league-gothic": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/major-mono-display": "^5.3.0",
    "@fontsource/metal-mania": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nosifer": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/playfair-display-sc": "^5.3.0",
    "@fontsource/poiret-one": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/rock-salt": "^5.3.0",
    "@fontsource/rubik-glitch": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@fontsource/sedgwick-ave-display": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
