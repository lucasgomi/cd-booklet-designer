  "build": {
    "appId": "com.lucasgomi.cdbooklet",
    "productName": "CD Booklet Designer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "!src/**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "cdbook",
        "name": "Proyecto de librito de CD",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CD-Booklet-Designer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CD-Booklet-Designer-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lucasgomi",
        "repo": "cd-booklet-designer"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasgomi/cd-booklet-designer.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
